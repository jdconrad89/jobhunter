<div class="auth-container">
  <div class="auth-box">
    <h1>Choose a new password</h1>

    <% if @user.errors.any? %>
      <div class="auth-errors">
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: password_reset_path(token: @token), method: :patch, local: true, class: "auth-form" do |f| %>
      <div class="form-group">
        <%= f.label :password, "New password", class: "form-label" %>
        <%= f.password_field :password, class: "form-input", required: true, minlength: 6, autofocus: true %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, "Confirm password", class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-input", required: true, minlength: 6 %>
      </div>

      <%= f.submit "Update password", class: "form-submit" %>
    <% end %>

    <div class="auth-links">
      <p><%= link_to "Back to log in", login_path, class: "auth-link" %></p>
    </div>
  </div>
</div>
